# Copie para .env para apontar a stack local para a Azure OpenAI real.
# NUNCA faça commit do .env. Em Kubernetes esses valores vêm do vault.

# Azure OpenAI
AZURE_API_KEY=
AZURE_API_BASE=https://<seu-recurso>.openai.azure.com
AZURE_API_VERSION=2025-04-01-preview

# Gateway (a master key precisa começar com "sk-"; gere com: echo "sk-$(openssl rand -hex 32)")
LITELLM_MASTER_KEY=
# Criptografa credenciais no banco. Defina uma vez e nunca mude.
LITELLM_SALT_KEY=

# Traces (com `make up-obs`, use o Jaeger local)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
